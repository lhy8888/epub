<Window x:Class="QuietRead.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QuietRead · 静读"
        Width="1180" Height="840" MinWidth="700" MinHeight="460" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" AllowDrop="True" Loaded="Window_Loaded"
        DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Background="{DynamicResource AppBrush}">
    <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="3" /><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="SidebarButton" Content="☰" FontSize="19" Width="38" Padding="0" Click="Sidebar_Click" ToolTip="显示或隐藏目录" AutomationProperties.Name="显示或隐藏目录" />
          <Path Data="M 1,2 L 1,22 C 7,21 10,22 13,24 C 16,22 19,21 25,22 L 25,2 C 20,1 16,2 13,4 C 10,2 6,1 1,2 M 13,4 L 13,24"
                Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" Width="26" Height="26" Margin="12,0,10,0" />
          <TextBlock Text="静读" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="28,0,16,0" VerticalAlignment="Center">
          <TextBlock x:Name="BookTitleText" Text="QuietRead" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="BookAuthorText" Text="留一点时间，给阅读。" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="HomeButton" Content="最近" Click="Home_Click" ToolTip="返回最近阅读" />
          <Button x:Name="LibraryButton" Content="书库" Click="Library_Click" AutomationProperties.Name="书库与阅读数据备份" />
          <Button Content="打开" Click="Open_Click" ToolTip="打开 EPUB" />
          <Button x:Name="BookmarkButton" Content="＋书签" Click="Bookmark_Click" IsEnabled="False" ToolTip="添加当前位置书签" />
          <Button x:Name="FullScreenButton" Content="全屏" Click="FullScreen_Click" ToolTip="切换全屏阅读" />
          <Button x:Name="AppearanceButton" Content="Aa" FontSize="19" Click="Appearance_Click" ToolTip="阅读外观" AutomationProperties.Name="阅读外观" />
        </StackPanel>
      </Grid>
    </Border>
    <ProgressBar x:Name="BusyBar" Grid.Row="1" IsIndeterminate="True" Visibility="Hidden" BorderThickness="0"
                 Foreground="{DynamicResource AccentBrush}" Background="Transparent" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="268" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock x:Name="ChapterCountText" Text="书籍导航" Margin="20,22,20,14" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" />
          <TabControl x:Name="SidebarTabs" Grid.Row="1">
            <TabItem Header="目录">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBox x:Name="TocFilter" TextChanged="TocFilter_Changed" MaxLength="100" Margin="12,8" AutomationProperties.Name="筛选目录标题" />
              <ListBox x:Name="TocList" Grid.Row="1" SelectionChanged="Toc_SelectionChanged" AutomationProperties.Name="书籍目录">
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid Margin="{Binding Indent}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="{Binding Toggle}" Tag="{Binding Index}" Click="TocToggle_Click" Visibility="{Binding ToggleVisibility}" Padding="2,0" MinHeight="24" AutomationProperties.Name="展开或折叠子目录" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentMark}" Foreground="{DynamicResource AccentBrush}" FontSize="10" VerticalAlignment="Center" Margin="2,0,4,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              </Grid>
            </TabItem>
            <TabItem Header="书签">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock x:Name="BookmarksHint" Text="阅读时点击「＋书签」保存位置。" Margin="18,14" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
                <ListBox x:Name="BookmarksList" Grid.Row="1" SelectionChanged="Bookmarks_SelectionChanged" AutomationProperties.Name="书签列表">
                  <ListBox.ItemTemplate><DataTemplate>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,0" /></StackPanel>
                      <Button Grid.Column="1" Content="×" Padding="6,0" MinHeight="24" VerticalAlignment="Top" Click="DeleteBookmark_Click" ToolTip="删除书签" AutomationProperties.Name="删除书签" />
                    </Grid>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>
            <TabItem Header="查找">
              <Grid Margin="10,12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="SearchBox" MaxLength="128" AutomationProperties.Name="全文搜索关键词" />
                  <Button x:Name="SearchButton" Grid.Column="1" Content="查找" Click="Search_Click" Padding="8,6" IsEnabled="False" />
                  <Button x:Name="SearchCancelButton" Grid.Column="2" Content="停止" Click="CancelSearch_Click" Padding="6,6" IsEnabled="False" AutomationProperties.Name="停止全文搜索" />
                </Grid>
                <StackPanel Grid.Row="1">
                  <WrapPanel Margin="4,8,0,0"><CheckBox x:Name="SearchChapter" Content="当前章" Margin="0,0,8,0" /><CheckBox x:Name="SearchCase" Content="区分大小写" Margin="0,0,8,0" /><CheckBox x:Name="SearchWholeWord" Content="整词" ToolTip="拉丁字母、数字和组合符为连续词；汉字按字边界匹配" /></WrapPanel>
                  <TextBlock x:Name="SearchStatusText" Text="输入文字，点击「查找」搜索全书。" FontSize="11" TextWrapping="Wrap" Margin="4,10" Foreground="{DynamicResource SecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ProgressBar x:Name="SearchProgressBar" Grid.Row="2" Minimum="0" Maximum="100" Height="4" Margin="4,0,4,8" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="全文搜索进度" />
                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="SearchPreviousButton" Content="上一个" Click="SearchPrevious_Click" IsEnabled="False" FontSize="11" Padding="6,4" AutomationProperties.Name="上一个搜索结果" />
                    <TextBlock x:Name="SearchPositionText" Text="—" VerticalAlignment="Center" MinWidth="46" TextAlignment="Center" FontSize="11" />
                    <Button x:Name="SearchNextButton" Content="下一个" Click="SearchNext_Click" IsEnabled="False" FontSize="11" Padding="6,4" AutomationProperties.Name="下一个搜索结果" />
                  </StackPanel>
                  <Button x:Name="SearchReturnButton" Content="返回搜索前位置" Click="SearchReturn_Click" IsEnabled="False" HorizontalAlignment="Left" FontSize="11" Padding="6,4" />
                </StackPanel>
                <ListBox x:Name="SearchList" Grid.Row="4" Padding="0" SelectionChanged="Search_SelectionChanged" AutomationProperties.Name="全文搜索结果">
                  <ListBox.ItemTemplate><DataTemplate>
                    <StackPanel><TextBlock Text="{Binding ChapterTitle}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                      <TextBlock Text="{Binding Snippet}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>
            <TabItem Header="批注">
              <Grid Margin="10,12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="在正文选中文字，再点击高亮。" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" />
                  <DockPanel Margin="0,8"><Button x:Name="AnnotationAddButton" Content="选区高亮" Click="AddAnnotation_Click" Padding="7,4" IsEnabled="False" />
                    <ComboBox x:Name="AnnotationColorCombo" SelectedIndex="0" AutomationProperties.Name="批注颜色"><ComboBoxItem Content="黄色" Tag="Yellow" /><ComboBoxItem Content="绿色" Tag="Green" /><ComboBoxItem Content="蓝色" Tag="Blue" /><ComboBoxItem Content="粉色" Tag="Rose" /></ComboBox>
                  </DockPanel>
                </StackPanel>
                <TextBox x:Name="AnnotationNoteBox" Grid.Row="1" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="76" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="批注笔记" />
                <WrapPanel Grid.Row="2" Margin="0,8"><Button x:Name="AnnotationSaveButton" Content="保存笔记" Click="SaveAnnotation_Click" Padding="6,4" IsEnabled="False" /><Button x:Name="AnnotationJumpButton" Content="定位" Click="JumpAnnotation_Click" Padding="6,4" IsEnabled="False" /><Button x:Name="AnnotationDeleteButton" Content="删除" Click="DeleteAnnotation_Click" Padding="6,4" IsEnabled="False" /></WrapPanel>
                <ListBox x:Name="AnnotationsList" Grid.Row="3" SelectionChanged="Annotation_SelectionChanged" AutomationProperties.Name="高亮和笔记列表">
                  <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Range.Text}" TextWrapping="Wrap" FontSize="13" MaxHeight="90" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" MaxHeight="55" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </TabItem>
          </TabControl>
          <TextBlock Grid.Row="2" Text="本地阅读 · 位置自动保存" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="20,16" />
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource ReaderBrush}">
        <Grid>
          <Grid x:Name="ReaderPane" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock x:Name="ChapterTitleText" Margin="32,20,32,8" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            <FlowDocumentScrollViewer x:Name="Reader" Grid.Row="1" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" MaxWidth="880" HorizontalAlignment="Stretch"
              IsSelectionEnabled="True" ScrollViewer.ScrollChanged="Reader_ScrollChanged" SizeChanged="Reader_SizeChanged" AutomationProperties.Name="书籍正文" />
          </Grid>
          <ScrollViewer x:Name="WelcomePane" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="480" Margin="32,78,32,40" HorizontalAlignment="Stretch">
              <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left" Margin="0,0,0,28">
                <Path Data="M 1,2 L 1,22 C 7,21 10,22 13,24 C 16,22 19,21 25,22 L 25,2 C 20,1 16,2 13,4 C 10,2 6,1 1,2 M 13,4 L 13,24"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Stretch="Uniform" Width="32" Height="30" />
              </Border>
              <TextBlock Text="打开一本书。" FontSize="32" FontWeight="SemiBold" />
              <TextBlock Text="拖入 EPUB，或选择本地文件。" Foreground="{DynamicResource SecondaryBrush}" FontSize="15" Margin="0,12,0,26" />
              <StackPanel Orientation="Horizontal"><Button Content="选择 EPUB 文件" Click="Open_Click" Style="{StaticResource PrimaryButton}" Padding="22,11" />
                <Button Content="使用说明" Click="Help_Click" Margin="12,0,0,0" /></StackPanel>
              <TextBlock Text="最近阅读" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,42,0,10" />
              <TextBlock x:Name="RecentHint" Text="打开的书籍会显示在这里。" FontSize="13" Foreground="{DynamicResource SecondaryBrush}" Margin="0,8" />
              <ItemsControl x:Name="RecentList"><ItemsControl.ItemTemplate><DataTemplate>
                <Button Click="Recent_Click" HorizontalContentAlignment="Stretch" Margin="0,4" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="继续 →" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource AccentBrush}" />
                  </Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Button x:Name="ClearHistoryButton" Content="清除阅读记录" Click="ClearHistory_Click" HorizontalAlignment="Left" Margin="0,14,0,0" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
      <Grid x:Name="FootnoteOverlay" Grid.ColumnSpan="2" Background="{DynamicResource AppBrush}" Visibility="Collapsed"
            KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="脚注预览">
        <Border MaxWidth="620" MaxHeight="520" Margin="20" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="注释" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="FootnoteCloseButton" Grid.Column="1" Content="关闭" Click="FootnoteClose_Click" AutomationProperties.Name="关闭脚注并返回正文" />
            </Grid>
            <FlowDocumentScrollViewer x:Name="FootnoteReader" Grid.Row="1" MinHeight="80" IsToolBarVisible="False" IsSelectionEnabled="True"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="{DynamicResource ReaderBrush}"
              AutomationProperties.Name="脚注正文" Margin="0,12" />
            <StackPanel Grid.Row="2">
              <TextBlock x:Name="FootnoteHint" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" AutomationProperties.LiveSetting="Polite" />
              <Button x:Name="FootnoteJumpButton" Content="跳转到原文" Click="FootnoteJump_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid Margin="0,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BackButton" Content="↶" Click="Back_Click" IsEnabled="False" Padding="7,4" AutomationProperties.Name="返回上次跳转位置" ToolTip="返回上次跳转位置" />
            <Button x:Name="ForwardButton" Content="↷" Click="Forward_Click" IsEnabled="False" Padding="7,4" AutomationProperties.Name="前进到下一跳转位置" ToolTip="前进到下一跳转位置" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <DockPanel><Button x:Name="RetrySaveButton" Content="重试保存" Click="RetrySave_Click" Visibility="Collapsed" Padding="3,0" MinHeight="16" FontSize="10" /><TextBlock x:Name="SaveStatusText" Text="" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryBrush}" AutomationProperties.LiveSetting="Polite" /></DockPanel>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PreviousButton" Content="← 上一页" Click="Previous_Click" IsEnabled="False" FontSize="12" ToolTip="上一屏；到达段首后继续上一段或上一章" />
          <TextBlock x:Name="ProgressText" Text="—" VerticalAlignment="Center" FontSize="12" MinWidth="140" TextAlignment="Center" Margin="12,0" />
          <Button x:Name="NextButton" Content="下一页 →" Click="Next_Click" IsEnabled="False" FontSize="12" ToolTip="下一屏；到达段尾后继续下一段或下一章" />
        </StackPanel>
        <TextBlock x:Name="PartText" Grid.Column="2" Text="" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" />
      </Grid>
    </Border>
    <Popup x:Name="AppearancePopup" PlacementTarget="{Binding ElementName=AppearanceButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Width="300" Margin="4,8">
        <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="阅读外观" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20" />
          <CheckBox x:Name="BookAppearance" Content="本书独立外观（关闭后使用全局默认）" Checked="AppearanceScope_Changed" Unchecked="AppearanceScope_Changed" Margin="0,0,0,12" IsEnabled="False" />
          <WrapPanel Margin="0,0,0,12"><Button Content="小说预设" Tag="Novel" Click="AppearancePreset_Click" Padding="6,4" /><Button Content="文档预设" Tag="Document" Click="AppearancePreset_Click" Padding="6,4" /><Button Content="本书恢复默认" Click="ResetBookAppearance_Click" Padding="6,4" /></WrapPanel>
          <TextBlock Text="背景" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,18">
            <Button Content="纸白" Tag="Paper" Click="Theme_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <Button Content="暖色" Tag="Sepia" Click="Theme_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <Button Content="夜间" Tag="Dark" Click="Theme_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
          </StackPanel>
          <TextBlock Text="字体" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,8" />
          <ComboBox x:Name="FontCombo" SelectionChanged="Font_Changed" Margin="0,0,0,18" AutomationProperties.Name="正文字体">
            <ComboBoxItem Content="宋体 · 中文阅读" Tag="Serif" />
            <ComboBoxItem Content="微软雅黑 · 清晰简洁" Tag="Sans" />
            <ComboBoxItem Content="Georgia · 英文阅读" Tag="Georgia" />
          </ComboBox>
          <DockPanel><TextBlock Text="字号" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" />
            <TextBlock x:Name="FontSizeLabel" Text="22" FontSize="12" HorizontalAlignment="Right" /></DockPanel>
          <Slider x:Name="FontSizeSlider" Minimum="14" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Value="22" ValueChanged="Appearance_Changed" Margin="0,10,0,18" AutomationProperties.Name="正文字号" />
          <TextBlock Text="行距" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" />
          <Slider x:Name="LineSlider" Minimum="1.2" Maximum="2.4" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="1.8" ValueChanged="Appearance_Changed" Margin="0,10,0,18" AutomationProperties.Name="正文行距" />
          <TextBlock Text="阅读宽度" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" />
          <Slider x:Name="WidthSlider" Minimum="520" Maximum="1100" TickFrequency="20" IsSnapToTickEnabled="True" Value="800" ValueChanged="Appearance_Changed" Margin="0,10,0,18" AutomationProperties.Name="阅读宽度" />
          <TextBlock Text="段距" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" /><Slider x:Name="ParagraphSpacingSlider" Minimum="0" Maximum="2" Value="0.8" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Appearance_Changed" Margin="0,8,0,14" AutomationProperties.Name="正文段距" />
          <DockPanel><TextBlock Text="首行缩进" FontSize="12" /><TextBlock x:Name="IndentLabel" Text="遵循来源" FontSize="12" HorizontalAlignment="Right" /></DockPanel>
          <Slider x:Name="IndentSlider" Minimum="-1" Maximum="4" Value="-1" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Appearance_Changed" Margin="0,8,0,14" AutomationProperties.Name="首行缩进，负一为遵循来源" />
          <ComboBox x:Name="AlignmentCombo" SelectedIndex="0" SelectionChanged="Alignment_Changed" Margin="0,0,0,14" AutomationProperties.Name="正文对齐"><ComboBoxItem Content="遵循来源对齐" Tag="Source" /><ComboBoxItem Content="左对齐" Tag="Left" /><ComboBoxItem Content="居中" Tag="Center" /><ComboBoxItem Content="右对齐" Tag="Right" /><ComboBoxItem Content="两端对齐" Tag="Justify" /></ComboBox>
          <Button Content="使用说明" Click="Help_Click" FontSize="12" />
        </StackPanel></ScrollViewer>
      </Border>
    </Popup>
  </Grid>
</Window>
