<Window x:Class="QuietRead.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuietRead · 书库与阅读数据" Width="920" Height="660" MinWidth="740" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
      <TextBox x:Name="FilterBox" MaxLength="100" TextChanged="Filter_Changed" AutomationProperties.Name="筛选书名、作者、标签或系列" />
      <ComboBox x:Name="StatusFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="8,0" AutomationProperties.Name="筛选阅读状态"><ComboBoxItem Content="全部状态" Tag="" /><ComboBoxItem Content="未读" Tag="Unread" /><ComboBoxItem Content="在读" Tag="Reading" /><ComboBoxItem Content="已读" Tag="Finished" /></ComboBox>
      <ComboBox x:Name="SortCombo" Grid.Column="2" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="书库排序"><ComboBoxItem Content="最近阅读" /><ComboBoxItem Content="书名" /><ComboBoxItem Content="作者" /></ComboBox>
    </Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
      <ListBox x:Name="BooksList" SelectionChanged="Book_SelectionChanged" AutomationProperties.Name="长期书库" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Author}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0" /><TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="本地元数据" FontSize="17" Margin="0,0,0,12" /><TextBlock Text="书名" /><TextBox x:Name="TitleBox" MaxLength="256" Margin="0,5,0,10" AutomationProperties.Name="本地书名" />
        <TextBlock Text="作者" /><TextBox x:Name="AuthorBox" MaxLength="256" Margin="0,5,0,10" AutomationProperties.Name="本地作者" />
        <TextBlock Text="标签（用逗号分隔）" /><TextBox x:Name="TagsBox" MaxLength="655" Margin="0,5,0,10" AutomationProperties.Name="本地标签" />
        <TextBlock Text="系列" /><TextBox x:Name="SeriesBox" MaxLength="100" Margin="0,5,0,10" AutomationProperties.Name="本地系列" />
        <ComboBox x:Name="ReadingState" SelectedIndex="1" Margin="0,0,0,12" AutomationProperties.Name="阅读状态"><ComboBoxItem Content="未读" Tag="Unread" /><ComboBoxItem Content="在读" Tag="Reading" /><ComboBoxItem Content="已读" Tag="Finished" /></ComboBox>
        <Button Content="保存元数据" Click="SaveMetadata_Click" HorizontalAlignment="Left" />
        <TextBlock Text="修改仅保存在本机，不写回 EPUB。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" Margin="0,10,0,12" />
        <Button Content="导出本书 JSON" Click="ExportBook_Click" HorizontalAlignment="Left" /><Button Content="导出本书 Markdown 摘录" Click="ExportMarkdown_Click" HorizontalAlignment="Left" Margin="2,6,2,0" />
      </StackPanel></ScrollViewer>
    </Grid>
    <WrapPanel Grid.Row="2" Margin="0,16,0,8"><Button Content="打开选中书籍" Click="Open_Click" /><Button Content="重新关联文件" Click="Associate_Click" /><Button Content="移除书库条目" Click="Remove_Click" /><Button Content="备份全部 JSON" Click="ExportAll_Click" /><Button Content="导入阅读数据" Click="Import_Click" /></WrapPanel>
    <TextBlock x:Name="LibraryStatus" Grid.Row="3" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </Grid>
</Window>
