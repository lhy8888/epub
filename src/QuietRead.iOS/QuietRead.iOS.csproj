<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-ios26.2</TargetFramework>
    <RuntimeIdentifiers>ios-arm64;iossimulator-arm64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>io.github.lhy8888.quietread</ApplicationId>
    <ApplicationTitle>QuietRead</ApplicationTitle><ApplicationVersion>1.0.0</ApplicationVersion><ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <TrimMode>copy</TrimMode><MtouchInterpreter>all</MtouchInterpreter>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="12.1.4" />
    <ProjectReference GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers;SelfContained" Include="../QuietRead.Cross/QuietRead.Cross.csproj" />
  </ItemGroup>
</Project>
